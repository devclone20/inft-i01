# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/

# ── Secrets & keys — this repo is public by design; nothing secret enters it ─
.env
.env.*
*.key
*.pem
auth.json
.pi/auth.json
.pi/trust.json

# ── Per-owner personal data (PII) — LOCAL ONLY, never committed or pushed ────
# Owner profile written during forge, and any *.local.* the buyer creates.
.pi/owner.local.md
**/owner.local.md
*.local
*.local.*

# ── Pi runtime state ────────────────────────────────────────────────────────
.pi/sessions/
.pi/npm/
.pi/git/
*.log

# ── OS noise ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
